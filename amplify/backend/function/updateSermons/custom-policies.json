[
  {
    "Action": [
      "dynamodb:Query",
      "dynamodb:GetItem",
      "dynamodb:PutItem",
      "dynamodb:DeleteItem",
      "dynamodb:Scan"
    ],
    "Resource": [
      {
        "Fn::Sub": [
          "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${table}",
          {
            "table": {
              "Fn::If": [
                "IsGamma",
                "Sermons-gamma",
                "Sermons"
              ]
            }
          }
        ]
      }
    ]
  }
]
